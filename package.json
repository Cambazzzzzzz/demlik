{
  "name": "demlik",
  "version": "1.0.0",
  "description": "Modern Türkçe Chat Uygulaması",
  "main": "electron.js",
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "dev": "concurrently \"npm run server\" \"npm start\"",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.demlik.chat",
    "productName": "Demlik",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/demlik.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "keywords": ["chat", "messaging", "electron"],
  "author": "Demlik Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "better-sqlite3": "^9.2.2",
    "multer": "^1.4.5-lts.1",
    "cloudinary": "^1.41.0",
    "firebase-admin": "^12.0.0",
    "cors": "^2.8.5",
    "bcrypt": "^5.1.1"
  },
  "devDependencies": {
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "concurrently": "^8.2.2"
  }
}
